# Local-only defaults. Replace these before any public deployment.
PORT=3000
OTEL_AUTH_HEADER_VALUE=Bearer local-demo-only-change-me
DASHBOARD_TOKEN=
ENABLE_DEMO_SEED=true
MAX_OTLP_BODY_BYTES=2097152

